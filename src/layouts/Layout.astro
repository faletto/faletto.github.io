---
import "../styles/colors.css";
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
    	<link rel="preconnect" href="https://fonts.googleapis.com">
    	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    	<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Comic+Relief:wght@400;700&family=Lexend:wght@100..900&display=swap" rel="stylesheet">
    	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
		<meta name="generator" content={Astro.generator} />
       
		<title>{title} | Colin Faletto</title>
	</head>
	<body>
		<nav>
        <div class="nav-links" aria-label="Primary navigation">
            <a id="Portfolio" href="/">home</a>
            <a id="Labs" href="/labs">labs</a>
            <a href="https://github.com/faletto" target="_blank" rel="noopener no-referrer">github</a>
            <a href="https://www.linkedin.com/in/colin-faletto-44610a16b/" target="_blank" rel="noopener no-referrer">linkedin</a>
            <a href="mailto:faletto@uw.edu">email</a>
        </div>

       
    	</nav>
		<main style="flex: 1;">
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} Colin Faletto. Built in <a href="https://astro.build/">Astro</a> (<a href="https://github.com/faletto/faletto.github.io">source code</a>).</p>
		</footer>
        <script is:inline src="/ascii-particles.js"></script>
        <script is:inline src="/user-theme.js"></script>
	</body>
</html>

<style set:html={`#${title} { color: #fff; } html.fun-theme #${title} {color: var(--yellow)}`}></style>

<style>
	html {
		height: 100%;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    color: var(--text-color);
    font-family: "Lexend", sans-serif;
    background: #000;
    user-select: none;
    position: relative;
    overflow-x: hidden;
}

:global(.ascii-particles) {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: layout paint style;
}

:global(.ascii-particles span) {
    position: absolute;
    top: 0;
    left: 0;
    color: rgba(239, 239, 239, 0.9);
    font-size: 0.95rem;
    line-height: 1;
    will-change: transform, opacity;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.08);
}

nav,
main,
footer {
    position: relative;
    z-index: 1;
}

a {
    color: var(--link-color);
    text-decoration: none;
}
/* NAVBAR */
nav {
    display: flex;
    justify-content: center;
    position: relative;
    padding: 0 50px;
    height: 80px;
    align-items: center;
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
}

.nav-links a {
    color: var(--gray-4);
    text-transform: lowercase;
    letter-spacing: 0.03em;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
}

.nav-links a:hover,
.nav-links a:focus-visible {
	color: #fff;
}

.labelThemeToggle {
    position: absolute;
    right: 50px;
    cursor: pointer;
}

.labelThemeToggle input {
    /* Hides the checkbox */
    display: none;
}

.labelThemeToggle .themeIcon {
    font-size: 1.2em;
    transition: opacity 0.3s ease;
    position: absolute;
    top: 0;
    left: 0;
}
.labelThemeToggle .fa-face-laugh-beam {
    opacity: 0;
}
.labelThemeToggle input:checked ~ .fa-face-smile {
    opacity: 0;
}
.labelThemeToggle input:checked ~ .fa-face-laugh-beam {
    opacity: 1;
}






@keyframes rotate {
	to {
		--angle: 360deg;
	}
}

@property --angle {
  syntax: '<angle>';
  initial-value: 0deg;
  inherits: false;
}

/* FOOTER */
footer {
	text-align: center;
	padding: 2rem 1rem;
	margin-top: 4rem;
	color: var(--gray-4);
	font-size: 0.9rem;
}

footer p {
	margin: 0;
}
footer a {
	color: var(--gray-6)
}
footer a:hover{
	color: var(--grey-4)
}



@media(max-width: 600px) {
    /* NAVBAR */
    nav {
        padding: 0 20px;
    }

    .nav-links {
        gap: 16px;
        padding-right: 36px;
    }

    .labelThemeToggle {
        right: 20px;
    }

}

html.fun-theme body {
   font-family: "Comic Relief", sans-serif;
    background: #000;
}

html.fun-theme .nav-links a:hover,
html.fun-theme .nav-links a:focus-visible {
    color: var(--yellow)
}


</style>

