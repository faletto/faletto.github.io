---
import "../styles/colors.css";
import "../styles/global.css";
---
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pdf-lib/dist/pdf-lib.min.js"></script>

<script is:inline src="/merge_pdfs.js"></script>

<section class="labgrid-section">
    <div class="labgrid-header">
        <a id="portfolio-link" class="labgrid-portfolio-link" href="#" onclick="mergePDFs()">full portfolio (pdf)</a>
        <p id="loading-message" class="labgrid-loading-message">
            Loading PDFs... (make sure javascript is enabled)
        </p>
    </div>

    <div id="pdf-list" class="pdf-grid"></div>
</section>
<script is:inline src="/read-pdfs.js"></script>

<style>
    .labgrid-section {
        width: min(100%, 1040px);
        box-sizing: border-box;
        margin: 0 auto;
        padding: 0 24px;
        font-family: 'Space Mono', monospace;
    }

    .labgrid-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .labgrid-portfolio-link {
        color: var(--gray-4);
        text-decoration: none;
        text-transform: lowercase;
        letter-spacing: 0.03em;
        font-size: 1.5rem;
        transition: color 0.2s ease;
    }

    .labgrid-portfolio-link:hover,
    .labgrid-portfolio-link:focus-visible {
        color: #fff;
    }

    .labgrid-loading-message {
        margin: 0;
        color: var(--gray-4);
        font-size: 0.85rem;
        text-align: center;
    }
</style>

<style is:global>
.pdf-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.pdf-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 200px;
    padding: 0 0 18px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--gray-3) 70%, transparent);
}

.pdf-card-link {
    display: flex;
    flex: 0 0 auto;
    justify-content: flex-end;
    align-items: center;
    color: #fff;
    transition: color 0.2s ease;
}

.pdf-card-link:hover {
    color: var(--gray-4)
}

.pdf-card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1 1 auto;
    min-width: 0;
}

.pdf-card h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
}

.pdf-card p {
    margin: 0;
    color: var(--gray-5);
    font-size: 0.95rem;
    line-height: 1.6;
}

.pdf-card img {
    display: block;
    height: 250px;
    width: auto;
    aspect-ratio: 8.5 / 11;
    object-fit: cover;
    border-radius: 0;
    margin-top: 0;
}

.loading-message {
    justify-content: center;
    top: -1.5rem;
    left: 0;
    font-size: 40px;
}

html.fun-theme .pdf-card {
    border-bottom-color: color-mix(in srgb, var(--yellow) 30%, transparent);
}

@media (max-width: 768px) {
    .labgrid-section {
        padding: 0 20px;
    }

    .pdf-card {
        gap: 18px;
    }

    .pdf-card img {
        height: 200px;
        width: auto;
    }
}

</style>
