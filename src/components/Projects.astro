---
import "../styles/colors.css";

interface ProjectItem {
	title: string;
	description: string;
	link: string;
    photo?: string;
}

const projects: ProjectItem[] = [
    {
        title: "LightHouse",
        description:
            "Cross-platform scouting and strategy system for use at robotics competitions, with live data syncing between field scouts and drive team.",
        link: "https://github.com/NRG948/LightHouse",
        photo: "/lighthouse.png"
    },
    {
        title: "DubGuessr [WIP]",
        description: "Guessing game for interior locations across the University of Washington Campus.",
        link: "",
        photo: "/dubguessr.png"

    },
    {
		title: "12xGraph",
		description:
			"Web app for generating graphs for labs in the UW PHYS 12X series.",
		link: "/12xgraph",
        photo: "/12xgraph.svg"
	},
    
    
];
---

<section class="projects-section" id="projects">
	<div class="projects-header">
		<h2>Projects:</h2>
	</div>
	<div class="projects-list" role="list">
		{projects.map((project) => (
			<article class="project-card" role="listitem">
				<div class="project-copy">
					<h3>
						{project.link ? <a href={project.link}>{project.title}</a> : project.title}
					</h3>
					<p>{project.description}</p>
				</div>
				{project.photo && (
					<div class="project-media">
						{project.link ? (
							<a href={project.link} aria-label={project.title}>
								<img class="project-photo" src={project.photo} alt="" />
							</a>
						) : (
							<img class="project-photo" src={project.photo} alt="" />
						)}
					</div>
				)}
			</article>
		))}
	</div>
</section>

<style>
	.projects-section {
		width: min(100%, 1040px);
		margin: 0 auto;
		padding: 0 24px;
		font-family: 'Space Mono', monospace;
	}

	.projects-header {
		display: flex;
		justify-content: center;
		gap: 6px;
		margin-bottom: 24px;
	}

	.projects-header h2 {
		margin: 0;
		color: var(--text-color);
		font-size: 2rem;
		font-weight: 400;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.project-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 0;
		text-decoration: none;
		color: var(--text-color);
		border: 0;
		border-radius: 0;
		background: transparent;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	.project-card:hover,
	.project-card:focus-within {
		opacity: 1;
	}

	.project-copy {
		flex: 1 1 auto;
		min-width: 0;
	}

	.project-card h3 {
		margin: 0 0 10px;
		font-size: 1.1rem;
		font-weight: 400;
		line-height: 1.3;
	}

	.project-card h3 a {
		color: var(--text-color);
		transition: color 0.2s ease;
	}

	.project-card h3 a:hover {
		color: var(--gray-4);
	}

	.project-card p {
		margin: 0;
		color: var(--gray-4);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.project-media {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
	}

	.project-photo {
		display: block;
		width: auto;
		max-width: 100%;
		height: 100px;
		object-fit: contain;
	}

	@media (max-width: 768px) {
		.projects-section {
			padding: 0 20px;
		}

		.projects-header h2 {
			font-size: 1.5rem;
        }

		.project-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 14px;
		}

		.project-photo {
			width: min(280px, 100%);
		}
	}

	html.fun-theme .project-card h3 a,
	html.fun-theme .project-card h3 {
		color: #fff;
	}
</style>
