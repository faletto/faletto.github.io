---
import "../styles/colors.css";

export interface TimelineItem {
  date: string;
  title: string;
  description: string;
  tagTitle?: string;
  tags?: string[];
  link?: string;
  image?: string;
}

interface Props {
  items: TimelineItem[];
  title?: string;
}

const { items, title = "Timeline" } = Astro.props;
---

<section class="timeline-section">
  <div class="timeline-title-center">
    {title && <h2 class="timeline-title">{title}</h2>}
  </div>

  <div class="timeline-list" role="list">
    {items.map((item) => (
      <article class="timeline-item" role="listitem">
        <div class="timeline-copy">
          <time class="timeline-date">{item.date}</time>
          <h3 class="timeline-item-title">
            {item.link ? (
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </h3>
          <p class="timeline-description">{item.description}</p>
          {item.tags && item.tags.length > 0 && (
            <div class="timeline-tags-wrap">
              <h4 class="timeline-tags-title">{item.tagTitle ?? "Relevant skills:"}</h4>
              <div class="timeline-tags">
                {item.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>
        {item.image && (
          <div class="timeline-media">
            <img src={item.image} alt="" />
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .timeline-section {
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: 0 24px;
    font-family: 'Space Mono', monospace;
  }
  

  .timeline-title-center {
    display: flex;
    justify-content: center;
  }

  .timeline-title {
    margin: 0 0 28px;
    font-size: 2rem;
    color: var(--text-color);
    font-weight: 400;
  }


  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .timeline-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 0 0 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--gray-3) 70%, transparent);
  }

  .timeline-date {
    display: block;
    font-size: 0.85rem;
    color: var(--gray-4);
    margin-bottom: 10px;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .timeline-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .timeline-media {
    flex: 0 0 auto;
    align-self: center;
  }

  .timeline-media img {
    display: block;
    height: 100px;
    width: auto;
    object-fit: cover;
  }

  .timeline-item-title {
    font-size: 1.05rem;
    color: var(--text-color);
    margin: 0 0 10px;
    font-weight: 400;
    line-height: 1.3;
  }

  .timeline-item-title a {
    color: var(--text-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .timeline-item-title a:hover {
    color: #fff;
  }

  .timeline-description {
    color: var(--gray-5);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .timeline-tags-wrap {
    margin-top: 14px;
  }

  .timeline-tags-title {
    margin: 0 0 10px;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--gray-4);
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    padding: 4px 10px;
    background: color-mix(in srgb, var(--gray-2) 55%, transparent);
    color: var(--gray-6);
    border: 1px solid color-mix(in srgb, var(--gray-4) 35%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 400;
  }


  @media (max-width: 768px) {
    .timeline-section {
      padding: 0 20px;
    }

    .timeline-title {
      font-size: 1.5rem;
    }

    .timeline-item {
      flex-direction: column;
      gap: 14px;
    }

    .timeline-media img {
      width: min(240px, 100%);
    }
  }

  @media (max-width: 480px) {
    .timeline-section {
      padding: 0 15px;
    }

    .timeline-title {
      font-size: 1.5rem;
    }

    .timeline-line {
      left: 15px;
    }

    .timeline-marker {
      left: 15px;
      width: 35px;
      height: 35px;
    }

    .timeline-content {
      width: calc(100% - 65px);
      margin-left: 50px;
      padding: 15px;
    }

    .timeline-item-title {
      font-size: 1.1rem;
    }

    .timeline-description {
      font-size: 0.9rem;
    }
  }
</style>
