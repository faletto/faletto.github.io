<style>

    h2, p {
        margin-top: 0;
        font-family: "Space Mono", monospace;
    }
    p {
        margin-top: 0;
        font-size: 1.5rem;
    }

    a, a:visited {
    color: white;
    transition: color 0.2s ease;
    }

    a:hover,
    a:focus-visible {
	    color: var(--gray-4);
    }

    /* Hero */
    .hero {
        display: flex;
        justify-content: space-between;
        width: min(100%, 1040px);
        box-sizing: border-box;
        margin: 0 auto 10px;
        padding: 0 24px;
        align-items: center;
        gap: 44px;
    }

    .hero .text {
        flex: 1 1 0;
        width: 100%;
        min-width: 0;
        max-width: 54ch;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .hero .text h2 {
        font-size: 35px;
        background: var(--text-color);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0;
    }
    
    .hero .headshot {
        flex: 0 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 0;
    }
    .hero .headshot img {
        width: auto;
        height: var(--hero-text-height, auto);
        object-fit: cover;
        border: 1vmin solid;
        border-color: var(--gray-1);
        /*border-image: conic-gradient(
                from var(--angle),
                var(--gray-1),
                var(--gray-2),
                var(--gray-3),
                var(--gray-4),
                var(--gray-3),
                var(--gray-2),
                var(--gray-1)
            )
            1;
        animation: 3s rotate linear infinite; */
    }

    .portfolio-link {
        text-align: center;
        font-size: 150%;
    }
    .portfolio-link a {
        color: var(--blue);
    }

    @media (max-width: 600px) {
        .hero {
            padding: 0 20px;
            width: min(100%, 1040px);
        }

        .hero .text h2 {
            font-size: 30px;
        }
    }

    @media (max-width: 740px) {
        .hero {
            flex-direction: column-reverse;
            align-items: center;
            width: min(100%, 720px);
        }
        .hero .headshot {
            justify-content: center;
            align-items: center;
            flex-basis: auto;
            width: min(100%, 320px);
        }
        .hero .headshot img {
            width: 60%;
            height: auto;
        }
    }
    html.fun-theme .hero .headshot img {
        border-image: conic-gradient(
                from var(--angle),
                red,
                orange,
                yellow,
                green,
                blue,
                purple,
                red
            )
            1;
    }

</style>

<!-- This is some overengineered BS but it works -->
<!-- I hate frontend -->
<script>
    const hero = document.getElementById("hero");
    const text = hero?.querySelector(".text");
    const headshot = hero?.querySelector(".headshot img");

    if (hero && text && headshot instanceof HTMLImageElement) {
        const syncHeroImageHeight = () => {
            hero.style.setProperty("--hero-text-height", `${text.getBoundingClientRect().height}px`);
        };

        const loadHeroImage = () => {
            if (!headshot.src && headshot.dataset.src) {
                headshot.src = headshot.dataset.src;
            }
        };

        const initializeHeroImage = () => {
            syncHeroImageHeight();
            loadHeroImage();
        };

        const observer = new ResizeObserver(syncHeroImageHeight);
        observer.observe(text);
        window.addEventListener("resize", syncHeroImageHeight, { passive: true });

        if ("fonts" in document) {
            document.fonts.ready.then(initializeHeroImage, initializeHeroImage);
        } else {
            requestAnimationFrame(initializeHeroImage);
        }
    }
</script>
